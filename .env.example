# Sao chép thành .env rồi sửa. Tất cả đều không bắt buộc — có thể đặt sau trong /admin.
PORT=80
SITE_NAME=Deal Hay
SITE_LANG=vi
# Để trống thì lần đầu vào /admin sẽ tự hỏi tạo mật khẩu
ADMIN_PASSWORD=
# Mẫu link affiliate của BẠN, ví dụ Shopee:
# https://s.shopee.vn/an_redir?origin_link={url}&affiliate_id=MA_CUA_BAN&sub_id={sub}
AFFILIATE_TEMPLATE=
SUB_ID=
SITE_URL=
# Nhánh hoặc thẻ phiên bản trên GitHub muốn chạy (main, v1.0.0…)
APP_REF=main
